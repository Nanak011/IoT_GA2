# ThingsBoard
TB_HOST=eu.thingsboard.cloud
TB_USE_TLS=1
TB_MQTT_PORT=8883
# TB_CA_FILE=          # only for a self-hosted server with its own CA
# TB_TLS_INSECURE=0    # 1 = skip cert check (self-signed dev server ONLY)
TB_TOKEN_BDR01=paste-access-token-of-BDR-01
TB_TOKEN_BDR02=paste-access-token-of-BDR-02
TB_TOKEN_BDR03=paste-access-token-of-BDR-03
# REST login (only for provision_thingsboard.py and metrics.py)
TB_URL=https://eu.thingsboard.cloud
TB_USERNAME=your-tenant-login@example.com
TB_PASSWORD=your-password
# Sampling (demo values; production = 900 s normal / 60 s burst)
SENSOR_INTERVAL_SECONDS=5
SENSOR_BURST_INTERVAL_SECONDS=2
SIM_TIME_SCALE=12
# Store-and-forward
BUFFER_MAX_ROWS=20000
REPLAY_BATCH_SIZE=50
# Reconnect back-off (demo; production = 5 s .. 300 s)
BACKOFF_MIN_S=2
BACKOFF_MAX_S=20
SUPPLY_ZERO_SUSTAIN_S=60
