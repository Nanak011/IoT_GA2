                  "key": {
                    "type": "TIME_SERIES",
                    "key": "turbidity_ntu"
                  },
                  "valueType": "NUMERIC",
                  "value": null,
                  "predicate": {
                    "type": "NUMERIC",
                    "operation": "GREATER",
                    "value": {
                      "defaultValue": 50,
                      "userValue": null,
                      "dynamicValue": null
                    }
                  }
                }
              ],
              "spec": {
                "type": "SIMPLE"
              }
            },
            "schedule": null,
            "alarmDetails": "Turbidity ${turbidity_ntu} NTU > 50: silt ingress, chlorination efficiency reduced",
            "dashboardId": null
          }
        },
        "clearRule": {
          "condition": {
            "condition": [
              {
                "key": {
                  "type": "TIME_SERIES",
                  "key": "turbidity_ntu"
                },
                "valueType": "NUMERIC",
                "value": null,
